{
  "name": "@universal/playwright-framework",
  "version": "1.0.0",
  "description": "Universal, plug-and-play Playwright E2E testing framework for any web application",
  "main": "dist/cucumber/src/index.js",
  "types": "dist/cucumber/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cucumber/src/index.d.ts",
      "default": "./dist/cucumber/src/index.js"
    },
    "./adapter/v1": {
      "types": "./dist/cucumber/src/adapter/v1.d.ts",
      "default": "./dist/cucumber/src/adapter/v1.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist/cucumber && npm run build:cucumber",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:safari": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:parallel": "playwright test --workers=4",
    "build:cucumber": "tsc --project tsconfig.cucumber.json",
    "test:input-preparation": "npm run build:cucumber && cucumber-js --config cucumber-input-preparation.json",
    "test:validation": "npm run build:cucumber && node --test dist/cucumber/scripts/feature-validation.test.js",
    "test:features": "npm run build:cucumber && cucumber-js --config cucumber.json",
    "test:execution": "npm run build:cucumber && node --test dist/cucumber/scripts/execution-adapter.test.js && cucumber-js --config cucumber-retry-regression.json",
    "test:reporting": "npm run build:cucumber && node --test dist/cucumber/scripts/reporting.test.js && cucumber-js --config cucumber-reporting.json",
    "test:adapter": "npm run build:cucumber && node --test dist/cucumber/scripts/adapter-contract.test.js && cucumber-js --config cucumber-adapter.json",
    "review:revision": "npm run build && node dist/cucumber/scripts/reviewed-revision.js",
    "execute:synthetic": "npm run build:cucumber && node dist/cucumber/src/execution/cli.js",
    "test:features:regression": "npm run test:input-preparation && npm run test:validation && npm run test:features && npm run test:execution && node --test dist/cucumber/scripts/cucumber-timeouts.test.js && npm run test:reporting && npm run test:adapter",
    "report": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "clean": "rimraf dist reports screenshots test-results",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "playwright",
    "e2e",
    "testing",
    "automation",
    "framework",
    "typescript",
    "page-object-model",
    "universal",
    "generic",
    "reusable",
    "submodule"
  ],
  "author": "Universal Testing Framework Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/universal-testing/playwright-framework.git"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "allure-playwright": "^2.10.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-playwright": "^0.18.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@cucumber/cucumber-expressions": "18.0.1",
    "@cucumber/gherkin": "38.0.0",
    "@playwright/test": "1.55.1",
    "dotenv": "^16.3.0",
    "zod": "4.6.7"
  },
  "files": [
    "dist/cucumber",
    "config",
    "src",
    "fixtures",
    "features/execution",
    "features/support/step-timeout.ts",
    "cucumber-execution.json",
    "tsconfig.json",
    "tsconfig.cucumber.json",
    "docs/local-adapter-contract.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
