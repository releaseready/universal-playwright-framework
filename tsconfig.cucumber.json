{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/cucumber",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noEmitOnError": true
  },
  "include": [
    "src/input-preparation/**/*.ts",
    "src/validation/**/*.ts",
    "features/input-preparation/**/*.ts",
    "features/support/**/*.ts",
    "features/steps/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
